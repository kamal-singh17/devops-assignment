apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-platform
  namespace: monitoring
  labels:
    grafana_dashboard: "1" # Important: kube-prometheus-stack watches for this label
spec:
  data:
    platform-health.json: |-
      {
        "title": "Platform Health",
        "panels": [
          { "title": "Node CPU Usage", "type": "timeseries", "targets": [{ "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)" }] },
          { "title": "Pod Restarts (1h)", "type": "table", "targets": [{ "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total[1h])) > 0" }] },
          { "title": "API Service Logs (Loki)", "type": "logs", "targets": [{ "expr": "{app=\"api-service\"}", "datasource": "Loki" }] }
        ]
      }
