apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-platform
  namespace: monitoring
  labels:
    grafana_dashboard: "1"
data:
  platform-health.json: |-
    {
      "title": "Platform Health",
      "panels": [
        {
          "type": "timeseries",
          "title": "CPU Usage",
          "targets": [
            {
              "expr": "rate(node_cpu_seconds_total{mode!='idle'}[5m])"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Memory Available",
          "targets": [
            {
              "expr": "node_memory_MemAvailable_bytes"
            }
          ]
        },
        {
          "type": "logs",
          "title": "API Logs",
          "targets": [
            {
              "expr": "{app=\"api\"}",
              "datasource": "Loki"
            }
          ]
        }
      ]
    }
